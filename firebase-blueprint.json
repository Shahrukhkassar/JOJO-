{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User preferences and settings for the Jojo companion",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique Firebase Authentication UID"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar photo URL"
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["Hinglish", "Hindi", "English"],
          "description": "Preferred communication language"
        },
        "preferredVoiceSpeed": {
          "type": "number",
          "description": "TTS voice playback speed"
        },
        "preferredPitch": {
          "type": "number",
          "description": "TTS voice playback pitch"
        },
        "autoPlayVoice": {
          "type": "boolean",
          "description": "Whether Jojo should read out replies automatically"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated timestamp"
        }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Message between the user and Jojo",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique message identifier"
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase user ID who owns the conversation"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Author of the message"
        },
        "content": {
          "type": "string",
          "maxLength": 5000,
          "description": "Message text content"
        },
        "emotion": {
          "type": "string",
          "enum": ["caring", "playful", "cheerful", "encouraging", "calm", "enthusiastic", "study", "thoughtful"],
          "description": "Associated emotion state"
        },
        "language": {
          "type": "string",
          "maxLength": 50,
          "description": "Language used in the message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["id", "userId", "role", "content", "createdAt"]
    },
    "StudyNote": {
      "title": "Study Note",
      "description": "Saved BAMS or English study notes and mnemonics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique note identifier"
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of owner"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Note title"
        },
        "topic": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject or topic category"
        },
        "content": {
          "type": "string",
          "maxLength": 5000,
          "description": "Note body"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "title", "content", "createdAt", "updatedAt"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Recorded quiz practice result",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique quiz result identifier"
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "User UID"
        },
        "question": {
          "type": "string",
          "maxLength": 1000,
          "description": "The question asked"
        },
        "selectedOption": {
          "type": "string",
          "maxLength": 200,
          "description": "Option picked by user"
        },
        "correctOption": {
          "type": "string",
          "maxLength": 200,
          "description": "The correct answer"
        },
        "isCorrect": {
          "type": "boolean",
          "description": "Whether user got it right"
        },
        "explanation": {
          "type": "string",
          "maxLength": 2000,
          "description": "Explanation of concept"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Quiz timestamp"
        }
      },
      "required": ["id", "userId", "question", "selectedOption", "correctOption", "isCorrect", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user preferences, settings, and profile"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages sent between the user and Jojo"
    },
    "/users/{userId}/studyNotes/{noteId}": {
      "schema": "StudyNote",
      "description": "User saved study notes, mnemonics, and concepts"
    },
    "/users/{userId}/quizResults/{resultId}": {
      "schema": "QuizResult",
      "description": "Historical quiz attempts and practice records"
    }
  }
}
